#!/bin/sh
#
# OKO Wi-Fi: apply the stored station/SoftAP settings after insmod_wifi.sh has
# loaded the USB driver.  insmod_ko.sh starts insmod_wifi.sh in the background,
# so wlan0 may appear a few seconds after this script runs; oko-wifi waits for
# it (up to 30 s) and runs in the background so boot and divinus never block.

case "$1" in
	start)
		if [ -x /usr/bin/oko-wifi ]; then
			/usr/bin/oko-wifi apply >/dev/null 2>&1 &
		fi
		;;
	stop)
		[ -x /usr/bin/oko-wifi ] && /usr/bin/oko-wifi stop >/dev/null 2>&1
		;;
	restart)
		[ -x /usr/bin/oko-wifi ] && /usr/bin/oko-wifi stop >/dev/null 2>&1
		[ -x /usr/bin/oko-wifi ] && /usr/bin/oko-wifi apply >/dev/null 2>&1 &
		;;
	*)
		echo "usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac