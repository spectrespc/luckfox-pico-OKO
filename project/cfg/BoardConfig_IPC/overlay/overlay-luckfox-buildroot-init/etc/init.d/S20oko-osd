#!/bin/sh
#
# OKO OSD: divinus is the default streamer; OSD sidecar daemon startup.
#
# - always create /userdata/divinus.enable (rkipc is not in the image)
# - /userdata/divinus.yaml without reg0_text/reg0_size/reg0_color/reg3_text
#   or without the osd-sys region (old config) -> factory config
# - divinus active             -> create /tmp/osd.fifo and start /usr/bin/oko-osd
#
# Runs after S20linkmount (lexicographic order) and before S21appinit, so the
# markers and the config are ready before oko-lunch.sh starts the application.

DAEMON=/usr/bin/oko-osd
FIFO=/tmp/osd.fifo
PIDFILE=/tmp/oko-osd.pid

wait_userdata() {
	i=0
	while [ "$i" -lt 30 ]; do
		mount | grep -qw /userdata && return 0
		i=$((i + 1))
		sleep 0.1
	done
	return 1
}

start_daemon() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		return 0
	fi
	if [ ! -p "$FIFO" ]; then
		rm -f "$FIFO"
		mkfifo "$FIFO"
	fi
	setsid "$DAEMON" >/dev/null 2>&1 &
}

stop_daemon() {
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE")
		kill "$pid" 2>/dev/null
		i=0
		while [ "$i" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
			i=$((i + 1))
			sleep 0.1
		done
		kill -9 "$pid" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	rm -f "$FIFO"
}

case "$1" in
	start)
		if ! wait_userdata; then
			echo "oko-osd: /userdata is not mounted, skipping"
			exit 1
		fi

		# divinus is the only streamer in the OKO image.
		touch /userdata/divinus.enable

		# Old or hand-edited configs without the current OSD layout are replaced by
		# the factory one; reg0_text/size/color, reg3_text and the osd-sys region
		# identify the current format. Keep the first backup.
		if [ ! -f /userdata/divinus.yaml ] ||
			! grep -q 'reg0_text' /userdata/divinus.yaml ||
			! grep -q 'reg0_size' /userdata/divinus.yaml ||
			! grep -q 'reg0_color' /userdata/divinus.yaml ||
			! grep -q 'reg3_text' /userdata/divinus.yaml ||
			! grep -q 'osd-sys.txt' /userdata/divinus.yaml; then
			[ -f /userdata/divinus.yaml ] &&
				[ ! -f /userdata/divinus.yaml.bak ] &&
				cp -f /userdata/divinus.yaml /userdata/divinus.yaml.bak
			cp -f /oem/usr/share/divinus/divinus.yaml /userdata/divinus.yaml
		fi

		if [ -f /userdata/divinus.enable ] && [ -x /oem/usr/bin/divinus ]; then
			start_daemon
		fi
		;;
	stop)
		stop_daemon
		;;
	restart)
		stop_daemon
		start_daemon
		;;
	status)
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "oko-osd: running (pid $(cat "$PIDFILE"))"
			exit 0
		fi
		echo "oko-osd: not running"
		exit 1
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac