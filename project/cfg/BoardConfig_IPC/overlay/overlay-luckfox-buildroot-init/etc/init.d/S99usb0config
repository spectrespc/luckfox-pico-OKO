#!/bin/sh

TARGET_IP="172.32.0.93"

MAX_RETRIES=10

# OKO: the active profile pins the port to host (dr_mode = "host"), where the
# DWC3 registers no UDC at all: gadget/usb0 cannot work and restarting
# S50usbdevice would only loop.  The script stays role-aware so that switching
# the DTS back to "otg" restores the old behaviour without edits.
MODE_PATH="/proc/device-tree/usbdrd/usb@ffb00000/dr_mode"

usb_mode() {
	cat "$MODE_PATH" 2>/dev/null
}

# OKO: in dual-role mode the DTS string does not tell the current role.  Read
# it from the extcon registered by phy-rockchip-inno-usb2 (USB=1 -> device,
# USB-HOST=1 -> host).
usb_role() {
	for f in /sys/class/extcon/*/state; do
		[ -r "$f" ] || continue
		grep -q '^USB=1$' "$f" && { echo peripheral; return; }
		grep -q '^USB-HOST=1$' "$f" && { echo host; return; }
	done
	echo unknown
}

gadget_udc() {
	cat /sys/kernel/config/usb_gadget/rockchip/UDC 2>/dev/null
}

usb0_config() {
	[ "$(usb_role)" = "peripheral" ] || return 0

	local retries=0 current_ip
	current_ip=$(ifconfig usb0 2>/dev/null | grep -o 'inet addr:[^ ]*' | awk -F ':' '{print $2}')
	[ "$current_ip" = "$TARGET_IP" ] && return 0

	echo "current_ip = $current_ip"
	echo "TARGET_IP = $TARGET_IP"

	while [ "$current_ip" != "$TARGET_IP" ] && [ $retries -lt $MAX_RETRIES ]; do
		sleep .5
		echo "oko : set usb0 ip"
		ifconfig usb0 "$TARGET_IP" 2>/dev/null
		current_ip=$(ifconfig usb0 2>/dev/null | grep -o 'inet addr:[^ ]*' | awk -F ':' '{print $2}')
		retries=$((retries + 1))
	done

	if [ "$current_ip" != "$TARGET_IP" ]; then
		echo "usb0 config error"
	else
		echo "usb0 config success"
	fi
}

# The DWC3 unregisters its UDC when the role turns to host, and the configfs
# gadget is not re-bound when the port becomes a device again.  Watch the role
# and re-bind S50usbdevice as soon as the port is a device without a gadget.
# A failed re-bind backs off (5..60 s) instead of restarting the gadget and
# adbd in a tight loop when the cause is persistent.
usb_watch() {
	local last role retry=0 delay=5
	last=$(usb_role)
	while true; do
		role=$(usb_role)
		if [ "$role" = "peripheral" ]; then
			if [ -z "$(gadget_udc)" ]; then
				echo "usb gadget is not bound, restart S50usbdevice"
				/etc/init.d/S50usbdevice restart
				sleep 2
				if [ -z "$(gadget_udc)" ]; then
					retry=$((retry + 1))
					delay=$((retry * 5))
					[ "$delay" -gt 60 ] && delay=60
					echo "usb gadget still not bound; retry in ${delay}s"
				else
					retry=0
					delay=5
				fi
			else
				retry=0
				delay=5
			fi
			usb0_config
		elif [ "$role" != "$last" ]; then
			echo "usb role: $last -> $role"
		fi
		last="$role"
		sleep "$delay"
	done
}

case $1 in
start)
	if [ "$(usb_mode)" = "host" ]; then
		echo "usb: dr_mode=host, gadget and usb0 are not configured"
		exit 0
	fi
	usb0_config
	usb_watch &
	;;
stop) ;;
*)
	exit 1
esac