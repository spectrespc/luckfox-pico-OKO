#!/bin/sh
#
# OKO OSD sidecar for divinus.
#
# - every 15 s writes simulated telemetry to two files:
#     /tmp/osd-gps.txt  : "GPS <lat>N <lon>E"                (reg2, top-right)
#     /tmp/osd-dyn.txt  : "T <t>C\nBAT <p>%\nLTE <bars>/5 <dbm>dBm\n
#                          WiFi <bars>/5 <dbm>dBm"           (reg1, top-left,
#                          literal backslash-n: divinus renders it as 4 lines)
# - every 5 s writes real system stats to:
#     /tmp/osd-sys.txt  : "CPU <usage>%\nMEM FREE <free>%\nT <temp>C"
#                          (reg4, bottom-left, literal backslash-n: 3 lines)
# - accepts one-line messages on /tmp/osd.fifo and shows them in
#   /tmp/osd-msg.txt for 60 s (reg3, below the telemetry)
# - GPS/LTE/WiFi values are simulated; CPU, memory and temperature are real.

DYN=/tmp/osd-dyn.txt
GPS=/tmp/osd-gps.txt
SYS=/tmp/osd-sys.txt
MSG=/tmp/osd-msg.txt
STAMP=/tmp/osd-msg.ts
FIFO=/tmp/osd.fifo
PIDFILE=/tmp/oko-osd.pid
TTL=60

lat=550000 # 55.0000 N, units of 1/10000 degree
lon=373000 # 37.3000 E
temp=24
bat=100
lte=-78 # simulated LTE RSRP, dBm
wifi=-56 # simulated WiFi RSSI, dBm
tick=0

cleanup() {
	rm -f "$PIDFILE"
	exit 0
}
trap cleanup TERM INT

echo $$ >"$PIDFILE"

if [ ! -p "$FIFO" ]; then
	rm -f "$FIFO"
	mkfifo -m 666 "$FIFO"
fi

# Opening the FIFO read-write never blocks and keeps external writers working.
# With no data the read becomes a one-second sleep, which is also the loop
# period; a kill removes the only process, so no reader can be orphaned.
if ! exec 3<>"$FIFO"; then
	rm -f "$PIDFILE"
	exit 1
fi

coord() {
	printf '%d.%04d%s' $(($1 / 10000)) $(($1 % 10000)) "$2"
}

lte_bars() {
	if [ "$1" -ge -65 ]; then echo 5
	elif [ "$1" -ge -75 ]; then echo 4
	elif [ "$1" -ge -85 ]; then echo 3
	elif [ "$1" -ge -95 ]; then echo 2
	else echo 1
	fi
}

wifi_bars() {
	if [ "$1" -ge -50 ]; then echo 5
	elif [ "$1" -ge -60 ]; then echo 4
	elif [ "$1" -ge -70 ]; then echo 3
	elif [ "$1" -ge -80 ]; then echo 2
	else echo 1
	fi
}

write_dyn() {
	printf 'GPS %s %s\n' \
		"$(coord "$lat" N)" "$(coord "$lon" E)" >"$GPS.tmp"
	mv -f "$GPS.tmp" "$GPS"

	printf 'T %dC\\nBAT %d%%\\nLTE %s/5 %ddBm\\nWiFi %s/5 %ddBm\n' \
		"$temp" "$bat" "$(lte_bars "$lte")" "$lte" \
		"$(wifi_bars "$wifi")" "$wifi" >"$DYN.tmp"
	mv -f "$DYN.tmp" "$DYN"
}

write_cpu_mem() {
	# CPU load from /proc/stat (user + nice + system + idle + iowait + irq + softirq)
	local cpu_line=$(grep '^cpu ' /proc/stat)
	local cpu_total=$(echo "$cpu_line" | awk '{for(i=2;i<=NF;i++) sum+=$i; print sum}')
	local cpu_idle=$(echo "$cpu_line" | awk '{print $5}')

	# Memory: available memory as a percentage of total (free + reclaimable).
	local mem_total=$(grep '^MemTotal:' /proc/meminfo | awk '{print $2}')
	local mem_avail=$(grep '^MemAvailable:' /proc/meminfo | awk '{print $2}')
	[ -z "$mem_avail" ] && mem_avail=$(grep '^MemFree:' /proc/meminfo | awk '{print $2}')
	local mem_free_pct=$((mem_avail * 100 / mem_total))

	# CPU temperature: thermal_zone0 is "soc-thermal" on this board.
	local temp_raw=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
	if [ -z "$temp_raw" ]; then
		for f in /sys/class/thermal/thermal_zone*/temp; do
			[ -r "$f" ] && temp_raw=$(cat "$f") && break
		done
	fi
	local temp_whole=0 temp_frac=0
	if [ -n "$temp_raw" ]; then
		temp_whole=$((temp_raw / 1000))
		temp_frac=$(((temp_raw % 1000) / 100))
	fi

	# CPU usage calculation using previous values (if available)
	# Read previous values if they exist
	local prev_cpu_total prev_cpu_idle
	if [ -f /tmp/osd-cpu.stats ]; then
		read prev_cpu_total prev_cpu_idle < /tmp/osd-cpu.stats
	else
		prev_cpu_total=0
		prev_cpu_idle=0
	fi

	# Calculate difference
	local cpu_diff=$((cpu_total - prev_cpu_total))
	local idle_diff=$((cpu_idle - prev_cpu_idle))
	local usage=0
	if [ $cpu_diff -gt 0 ]; then
		usage=$(( (cpu_diff - idle_diff) * 100 / cpu_diff ))
		[ $usage -lt 0 ] && usage=0
		[ $usage -gt 100 ] && usage=100
	fi

	# Save current values for next iteration
	echo "$cpu_total $cpu_idle" > /tmp/osd-cpu.stats

	printf 'CPU %d%%\\nMEM FREE %d%%\\nT %d.%dC\n' \
		"$usage" "$mem_free_pct" "$temp_whole" "$temp_frac" >"$SYS.tmp"
	mv -f "$SYS.tmp" "$SYS"
}

write_msg() {
	printf '%s\n' "$1" | cut -c1-79 >"$MSG.tmp"
	mv -f "$MSG.tmp" "$MSG"
	date +%s >"$STAMP"
}

write_dyn
write_cpu_mem

while :; do
	if read -t 1 -r line <&3; then
		[ -n "$line" ] && write_msg "[$(date +%H:%M:%S)] $line"
	fi

	tick=$((tick + 1))

	if [ $((tick % 5)) -eq 0 ]; then
		write_cpu_mem
	fi

	if [ $((tick % 15)) -eq 0 ]; then
		lat=$((lat + RANDOM % 5 - 2))
		[ "$lat" -lt 1000 ] && lat=1000
		[ "$lat" -gt 999000 ] && lat=999000

		lon=$((lon + RANDOM % 5 - 2))
		[ "$lon" -lt 1000 ] && lon=1000
		[ "$lon" -gt 999000 ] && lon=999000

		temp=$((temp + RANDOM % 3 - 1))
		[ "$temp" -lt 22 ] && temp=22
		[ "$temp" -gt 28 ] && temp=28

		if [ $((tick % 60)) -eq 0 ] && [ "$bat" -gt 5 ]; then
			bat=$((bat - 1))
		fi

		lte=$((lte + RANDOM % 7 - 3))
		[ "$lte" -lt -110 ] && lte=-110
		[ "$lte" -gt -60 ] && lte=-60

		wifi=$((wifi + RANDOM % 7 - 3))
		[ "$wifi" -lt -85 ] && wifi=-85
		[ "$wifi" -gt -40 ] && wifi=-40

		write_dyn
	fi

	if [ -f "$STAMP" ]; then
		now=$(date +%s)
		then=$(cat "$STAMP")
		if [ $((now - then)) -ge "$TTL" ]; then
			: >"$MSG"
			rm -f "$STAMP"
		fi
	fi
done