#!/bin/sh
#
# OKO OSD sidecar for divinus.
#
# - every 15 s writes telemetry to two files:
#     /tmp/osd-gps.txt  : "GPS <lat>N <lon>E"                (reg2, top-right)
#     /tmp/osd-dyn.txt  : four lines                         (reg1, top-left,
#         real: "SHT21 <t>C <rh>%RH\nSTM32 <v>V <a>A <t>C <soc>%
#                <c0>/<c1>/<c2>V\nINA3221 <v>V <a>A <w>W\n
#                LTE <bars>/5 <dbm>dBm WiFi <bars>/5 <dbm>dBm"
#         fallback: "T <t>C\nBAT <p>%\nLTE ...\nWiFi ..."
#       (literal backslash-n: divinus renders it as four lines)
# - the WiFi field is real: RSSI comes from "wpa_cli signal_poll" (nl80211,
#   dBm) once "wpa_cli status" reports wpa_state=COMPLETED.  Four states:
#     associated with a valid RSSI -> "WiFi <bars>/5 <dbm>dBm"
#     SoftAP running (hostapd pid file is alive) -> "wifi ap"
#     adapter present, not associated, no SoftAP -> "wifi off"
#     no adapter (/sys/class/net/wlan0 absent) -> field omitted entirely,
#       which makes divinus drop the whole region when nothing is left.
#   LTE and GPS values are still simulated.
# - when /tmp/oko-ec.osd (written by "oko-ec daemon") is fresh (<= 30 s),
#   OK=1 and has SHT/EC/INA lines, the SHT21, STM32 and INA3221 readings are
#   real; otherwise the old simulated T/BAT telemetry is used.
# - every 5 s writes real system stats to:
#     /tmp/osd-sys.txt  : "CPU <usage>%\nMEM FREE <free>% SD FREE <f>/<cap>GiB\nT <temp>C"
#                          (reg4, bottom-left, literal backslash-n: 3 lines)
# - accepts one-line messages on /tmp/osd.fifo and shows them in
#   /tmp/osd-msg.txt for 60 s (reg3, below the telemetry)
# - CPU, memory and temperature are real; GPS and LTE are simulated.

WLAN=wlan0
AP_PID=/run/hostapd-$WLAN.pid
DYN=/tmp/osd-dyn.txt
GPS=/tmp/osd-gps.txt
REAL=/tmp/oko-ec.osd
REAL_TTL=30
SYS=/tmp/osd-sys.txt
MSG=/tmp/osd-msg.txt
STAMP=/tmp/osd-msg.ts
FIFO=/tmp/osd.fifo
PIDFILE=/tmp/oko-osd.pid
TTL=60

lat=550000 # 55.0000 N, units of 1/10000 degree
lon=373000 # 37.3000 E
temp=24
bat=100
lte=-78 # simulated LTE RSRP, dBm
tick=0

cleanup() {
	rm -f "$PIDFILE"
	exit 0
}
trap cleanup TERM INT

echo $$ >"$PIDFILE"

if [ ! -p "$FIFO" ]; then
	rm -f "$FIFO"
	mkfifo -m 666 "$FIFO"
fi

# Opening the FIFO read-write never blocks and keeps external writers working.
# With no data the read becomes a one-second sleep, which is also the loop
# period; a kill removes the only process, so no reader can be orphaned.
if ! exec 3<>"$FIFO"; then
	rm -f "$PIDFILE"
	exit 1
fi

coord() {
	printf '%d.%04d%s' $(($1 / 10000)) $(($1 % 10000)) "$2"
}

lte_bars() {
	if [ "$1" -ge -65 ]; then echo 5
	elif [ "$1" -ge -75 ]; then echo 4
	elif [ "$1" -ge -85 ]; then echo 3
	elif [ "$1" -ge -95 ]; then echo 2
	else echo 1
	fi
}

wifi_bars() {
	if [ "$1" -ge -50 ]; then echo 5
	elif [ "$1" -ge -60 ]; then echo 4
	elif [ "$1" -ge -70 ]; then echo 3
	elif [ "$1" -ge -80 ]; then echo 2
	else echo 1
	fi
}

# SoftAP runs hostapd with -P /run/hostapd-wlan0.pid (see oko-wifi).  A live
# pid alone is not enough: /run survives an AP->STA switch, so a recycled pid
# must not turn into a phantom "wifi ap" — check the process name as well.
# The address matters too: after a USB re-plug hostapd keeps running on the
# old netdev while the re-created wlan0 has no IPv4, and the AP is not
# serving; oko-wifi always puts the AP address on the interface.
ap_active() {
	local _pid
	_pid=$(cat "$AP_PID" 2>/dev/null)
	[ -n "$_pid" ] || return 1
	kill -0 "$_pid" 2>/dev/null || return 1
	[ "$(cat "/proc/$_pid/comm" 2>/dev/null)" = hostapd ] || return 1
	ip -4 addr show dev "$WLAN" 2>/dev/null | grep -q 'inet '
}

# Sets wifi_txt: "WiFi <bars>/5 <dbm>dBm" when associated with a usable RSSI,
# "wifi ap" while the SoftAP is running, "wifi off" when the adapter exists
# but is not connected, and empty when the adapter is physically absent (the
# caller then omits the whole field).
# wpa_cli is the only usable source: iw is not shipped and the WEXT/vendor
# procfs paths are disabled in this build, but supplicant runs on nl80211 and
# signal_poll returns dBm.  In AP mode there is no supplicant, so status just
# fails and the AP check decides.
wifi_read() {
	local _st _r
	wifi_txt=
	[ -e "/sys/class/net/$WLAN" ] || return 0
	_st=$(wpa_cli -i "$WLAN" status 2>/dev/null | \
		sed -n 's/^wpa_state=//p' | head -n 1)
	_r=$(wpa_cli -i "$WLAN" signal_poll 2>/dev/null | \
		sed -n 's/^RSSI=//p' | head -n 1)
	# Validate the format before comparing: a non-numeric value would make
	# test fail noisily.  Allowed range is -120..-1 dBm.
	case "$_r" in
		-1[01][0-9] | -120 | -[1-9] | -[1-9][0-9]) ;;
		*) _r="" ;;
	esac
	if [ "$_st" = COMPLETED ] && [ -n "$_r" ]; then
		wifi_txt="WiFi $(wifi_bars "$_r")/5 ${_r}dBm"
	elif ap_active; then
		wifi_txt="wifi ap"
	else
		wifi_txt="wifi off"
	fi
}

read_real() {
	real_ok=0
	real_sensor=0
	real_t=""
	real_bat=""
	real_sht=""
	real_ec=""
	real_ina=""

	[ -r "$REAL" ] || return 0

	ts=0
	ok=0
	t=""
	b=""
	sht=""
	ec=""
	ina=""
	while read -r key value; do
		case "$key" in
			TS) ts=$value ;;
			OK) ok=$value ;;
			T) t=$value ;;
			BAT) b=$value ;;
			SHT) sht=$value ;;
			EC) ec=$value ;;
			INA) ina=$value ;;
		esac
	done <"$REAL"

	case "$ts" in '' | *[!0-9]*) return 0 ;; esac
	[ "$ok" = 1 ] || return 0

	now=$(date +%s)
	[ $((now - ts)) -le "$REAL_TTL" ] || return 0

	real_ok=1
	real_t=$t
	real_bat=$b
	real_sht=$sht
	real_ec=$ec
	real_ina=$ina
	if [ -n "$sht" ] || [ -n "$ec" ] || [ -n "$ina" ]; then
		real_sensor=1
	fi
}

write_dyn() {
	printf 'GPS %s %s\n' \
		"$(coord "$lat" N)" "$(coord "$lon" E)" >"$GPS.tmp"
	mv -f "$GPS.tmp" "$GPS"

	read_real
	lte_bars_now=$(lte_bars "$lte")
	wifi_read

	if [ "$real_ok" = 1 ] && [ "$real_sensor" = 1 ]; then
		sht_str="$real_sht"
		ec_str="$real_ec"
		ina_str="$real_ina"
		[ -n "$sht_str" ] || sht_str="SHT21 --"
		[ -n "$ec_str" ] || ec_str="STM32 --"
		[ -n "$ina_str" ] || ina_str="INA --"

		# LTE and WiFi share the last line; no adapter means no WiFi tail
		# (and no trailing space before the closing literal "\n").
		if [ -n "$wifi_txt" ]; then
			printf '%s\\n%s\\n%s\\nLTE %s/5 %ddBm %s\n' \
				"$sht_str" "$ec_str" "$ina_str" \
				"$lte_bars_now" "$lte" "$wifi_txt" >"$DYN.tmp"
		else
			printf '%s\\n%s\\n%s\\nLTE %s/5 %ddBm\n' \
				"$sht_str" "$ec_str" "$ina_str" \
				"$lte_bars_now" "$lte" >"$DYN.tmp"
		fi
	else
		t_str="${temp}C"
		b_str="${bat}%"
		if [ "$real_ok" = 1 ]; then
			[ -n "$real_t" ] && t_str="$real_t"
			[ -n "$real_bat" ] && b_str="$real_bat"
		fi

		if [ -n "$wifi_txt" ]; then
			printf 'T %s\\nBAT %s\\nLTE %s/5 %ddBm\\n%s\n' \
				"$t_str" "$b_str" "$lte_bars_now" "$lte" \
				"$wifi_txt" >"$DYN.tmp"
		else
			printf 'T %s\\nBAT %s\\nLTE %s/5 %ddBm\n' \
				"$t_str" "$b_str" "$lte_bars_now" "$lte" >"$DYN.tmp"
		fi
	fi
	mv -f "$DYN.tmp" "$DYN"
}

write_cpu_mem() {
	# CPU load from /proc/stat (user + nice + system + idle + iowait + irq + softirq)
	local cpu_line=$(grep '^cpu ' /proc/stat)
	local cpu_total=$(echo "$cpu_line" | awk '{for(i=2;i<=NF;i++) sum+=$i; print sum}')
	local cpu_idle=$(echo "$cpu_line" | awk '{print $5}')

	# Memory: available memory as a percentage of total (free + reclaimable).
	local mem_total=$(grep '^MemTotal:' /proc/meminfo | awk '{print $2}')
	local mem_avail=$(grep '^MemAvailable:' /proc/meminfo | awk '{print $2}')
	[ -z "$mem_avail" ] && mem_avail=$(grep '^MemFree:' /proc/meminfo | awk '{print $2}')
	local mem_free_pct=$((mem_avail * 100 / mem_total))

	# CPU temperature: thermal_zone0 is "soc-thermal" on this board.
	local temp_raw=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
	if [ -z "$temp_raw" ]; then
		for f in /sys/class/thermal/thermal_zone*/temp; do
			[ -r "$f" ] && temp_raw=$(cat "$f") && break
		done
	fi
	local temp_whole=0 temp_frac=0
	if [ -n "$temp_raw" ]; then
		temp_whole=$((temp_raw / 1000))
		temp_frac=$(((temp_raw % 1000) / 100))
	fi

	# CPU usage calculation using previous values (if available)
	# Read previous values if they exist
	local prev_cpu_total prev_cpu_idle
	if [ -f /tmp/osd-cpu.stats ]; then
		read prev_cpu_total prev_cpu_idle < /tmp/osd-cpu.stats
	else
		prev_cpu_total=0
		prev_cpu_idle=0
	fi

	# Calculate difference
	local cpu_diff=$((cpu_total - prev_cpu_total))
	local idle_diff=$((cpu_idle - prev_cpu_idle))
	local usage=0
	if [ $cpu_diff -gt 0 ]; then
		usage=$(( (cpu_diff - idle_diff) * 100 / cpu_diff ))
		[ $usage -lt 0 ] && usage=0
		[ $usage -gt 100 ] && usage=100
	fi

	# Save current values for next iteration
	echo "$cpu_total $cpu_idle" > /tmp/osd-cpu.stats

	# NPU load: /proc/rknpu/load is "NPU load: NN%" on RV1106.  Appending it
	# to the existing CPU line avoids adding a fourth OSD line (the region at
	# reg4_posy=960 clips).  The file is absent when rknpu.ko is not loaded.
	local npu_suffix=""
	if [ -r /proc/rknpu/load ]; then
		local npu_raw=$(cat /proc/rknpu/load 2>/dev/null)
		local npu_pct=$(printf '%s' "$npu_raw" | sed -n 's/.*NPU load:[^0-9]*\([0-9][0-9]*\)%.*/\1/p' | head -n1)
		[ -n "$npu_pct" ] && npu_suffix=" NPU ${npu_pct}%"
	fi

	# SD summary: free/capacity in GiB with one decimal, appended to the MEM
	# line (same trick as the NPU suffix: no fourth line, the region clips).
	# /mnt/sdcard is a symlink into oem when no card is inserted, so require a
	# real mount entry, matching gating_sd_mounted() in divinus.
	local sd_txt="-"
	if grep -q '[[:space:]]/mnt/sdcard[[:space:]]' /proc/mounts 2>/dev/null; then
		local sd_kb=$(df -k /mnt/sdcard 2>/dev/null | awk 'NR == 2 {print $2, $4}')
		local cap_kb=${sd_kb% *}
		local free_kb=${sd_kb#* }
		if [ -n "$cap_kb" ] && [ -n "$free_kb" ]; then
			case "$cap_kb:$free_kb" in
				*[!0-9:]* | 0:*) ;;
				*)
					# Integer MiB, then tenths of GiB with rounding:
					# ceil-ish (x*10 + 512) / 1024.  Safe for cards up
					# to ~200 TiB because the division comes first.
					local fd=$(( (free_kb / 1024 * 10 + 512) / 1024 ))
					local td=$(( (cap_kb / 1024 * 10 + 512) / 1024 ))
					sd_txt=$(printf '%d.%d/%d.%dGiB' \
						$((fd / 10)) $((fd % 10)) \
						$((td / 10)) $((td % 10)))
					;;
			esac
		fi
	fi

	# The renderer splits lines on the two-character sequence "\n" (backslash
	# + n), not on a real newline: region_read_text_file() reads only the first
	# line and text.c handles "\\n".  Keep the backslashes literal.
	printf 'CPU %d%%%s\\nMEM FREE %d%% SD FREE %s\\nT %d.%dC\n' \
		"$usage" "$npu_suffix" "$mem_free_pct" "$sd_txt" \
		"$temp_whole" "$temp_frac" >"$SYS.tmp"
	mv -f "$SYS.tmp" "$SYS"
}

write_msg() {
	printf '%s\n' "$1" | cut -c1-79 >"$MSG.tmp"
	mv -f "$MSG.tmp" "$MSG"
	date +%s >"$STAMP"
}

write_dyn
write_cpu_mem

while :; do
	if read -t 1 -r line <&3; then
		[ -n "$line" ] && write_msg "[$(date +%H:%M:%S)] $line"
	fi

	tick=$((tick + 1))

	if [ $((tick % 5)) -eq 0 ]; then
		write_cpu_mem
	fi

	if [ $((tick % 15)) -eq 0 ]; then
		lat=$((lat + RANDOM % 5 - 2))
		[ "$lat" -lt 1000 ] && lat=1000
		[ "$lat" -gt 999000 ] && lat=999000

		lon=$((lon + RANDOM % 5 - 2))
		[ "$lon" -lt 1000 ] && lon=1000
		[ "$lon" -gt 999000 ] && lon=999000

		temp=$((temp + RANDOM % 3 - 1))
		[ "$temp" -lt 22 ] && temp=22
		[ "$temp" -gt 28 ] && temp=28

		if [ $((tick % 60)) -eq 0 ] && [ "$bat" -gt 5 ]; then
			bat=$((bat - 1))
		fi

		lte=$((lte + RANDOM % 7 - 3))
		[ "$lte" -lt -110 ] && lte=-110
		[ "$lte" -gt -60 ] && lte=-60

		write_dyn
	fi

	if [ -f "$STAMP" ]; then
		now=$(date +%s)
		then=$(cat "$STAMP")
		if [ $((now - then)) -ge "$TTL" ]; then
			: >"$MSG"
			rm -f "$STAMP"
		fi
	fi
done