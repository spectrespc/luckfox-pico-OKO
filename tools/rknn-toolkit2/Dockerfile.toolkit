FROM python:3.8-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libgomp1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Official rknn-toolkit2 1.6.0 wheel from the airockchip repository.
ARG RKNN_WHEEL_URL=https://raw.githubusercontent.com/airockchip/rknn-toolkit2/v1.6.0/rknn-toolkit2/docker/docker_file/ubuntu_20_04_cp38/rknn_toolkit2-1.6.0+81f21f4d-cp38-cp38-linux_x86_64.whl
RUN curl -fsSL -o /tmp/rknn-toolkit2.whl "$RKNN_WHEEL_URL" \
    && pip install --no-cache-dir --no-deps /tmp/rknn-toolkit2.whl \
    && rm -f /tmp/rknn-toolkit2.whl

# The wheel declares tensorflow/torch deps that ONNX->RKNN conversion does not
# use. Install only what the converter and the ONNX path need.
RUN pip install --no-cache-dir \
        "numpy==1.23.5" "protobuf==3.20.3" flatbuffers onnx==1.14.1 \
        onnxoptimizer onnxruntime==1.15.1 opencv-python-headless \
        ruamel.yaml scipy tqdm psutil h5py fast-histogram \
        humanfriendly coloredlogs

WORKDIR /work
