FROM python:3.8-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# The airockchip YOLO11 fork is pinned to a 2024-10 commit; its exporter
# imports torch, torchvision and the usual ultralytics runtime helpers.
RUN pip install --no-cache-dir \
        torch==1.13.1+cpu torchvision==0.14.1+cpu \
        --extra-index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
        "numpy==1.24.4" "onnx==1.17.0" "onnxslim==0.1.34" \
        opencv-python-headless pyyaml requests tqdm matplotlib seaborn \
        scipy pandas psutil py-cpuinfo "ultralytics-thop>=2.0.0" \
        "onnxruntime==1.19.2"

WORKDIR /work