# USB host class support for OKO: the board runs in dual-role (OTG) mode, so
# devices behind a USB hub must be usable.  Hub support itself is part of
# usbcore (CONFIG_USB), there is no separate "hub" symbol.
#
# The vendor defconfig is shared with the other Luckfox boards and leaves these
# classes off, so they are enabled here for the active profile only.
# Everything is built in: the OKO image has no module loader path for the
# kernel tree besides the pre-built drv_ko set.

# HID (keyboard/mouse behind a hub)
CONFIG_INPUT_MOUSE=y
CONFIG_HID=y
CONFIG_USB_HID=y

# USB network adapters: CDC ECM/NCM, RNDIS (phones in modem mode), ASIX, Realtek
CONFIG_USB_USBNET=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y

# Bluetooth: HCI over USB plus the Realtek firmware loader
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_RTL=y

# Log every new USB device, handy when bringing up a hub on the bench
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# The vendor defconfig builds the legacy g_mass_storage gadget in.  It grabs
# the UDC on boot, fails with -EINVAL because no backing file is configured,
# and that aborts the DWC3 peripheral init: /sys/class/udc stays empty and the
# configfs gadget (adb/rndis, bound by S50usbdevice) can never start.
# Gadget functions are managed through configfs, so drop the legacy driver.
# CONFIG_USB_MASS_STORAGE is not set