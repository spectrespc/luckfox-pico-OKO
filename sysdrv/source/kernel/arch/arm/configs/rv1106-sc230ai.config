# Enable SmartSens SC230AI camera sensor
CONFIG_VIDEO_SC230AI=m

# This board is populated with SC230AI only.  The vendor defconfig builds the
# other sensor drivers as modules; disable them here instead of changing the
# shared defconfig used by the other Luckfox boards.
# CONFIG_VIDEO_SC3336 is not set
# CONFIG_VIDEO_IMX415 is not set
# CONFIG_VIDEO_MIS5001 is not set
# CONFIG_VIDEO_MIA1321 is not set
